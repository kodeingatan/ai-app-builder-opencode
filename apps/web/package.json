{
  "name": "ai-app-builder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "migration:generate": "tsx server/utils/migration-cli.ts generate",
    "migration:run": "tsx server/utils/migration-cli.ts run",
    "migration:revert": "tsx server/utils/migration-cli.ts revert",
    "builder:generate": "tsx server/services/ai-builder/cli.ts generate",
    "builder:preview": "tsx server/services/ai-builder/cli.ts preview",
    "builder:list": "tsx server/services/ai-builder/cli.ts list"
  },
  "dependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^4.0.0",
    "@pinia/nuxt": "^0.11.0",
    "naive-ui": "^2.44.0",
    "@vicons/carbon": "^0.13.0",
    "typeorm": "^1.1.0",
    "better-sqlite3": "^9.2.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.24.0",
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "vitest": "^4.0.0",
    "@nuxt/test-utils": "^3.19.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0"
  }
